{
  "crons": [
    { "path": "/api/cron/daily",        "schedule": "0 0 * * *" },
    { "path": "/api/cron/monthly",      "schedule": "0 1 1 * *" },
    { "path": "/api/cron/lease-expiry", "schedule": "0 9 * * *" }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "jnphousing.com" }],
      "destination": "https://jnphousing.co.kr/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.jnphousing.com" }],
      "destination": "https://jnphousing.co.kr/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.jnphousing.co.kr" }],
      "destination": "https://jnphousing.co.kr/:path*",
      "permanent": true
    }
  ]
}
